<% content_for :title, "専用質問一覧" %>

<div class="questions-container classroom-container">

  <!-- マイページボタン -->
  <%= link_to mypage_index_path,
      class: "mypage-icon-button",
      aria: { label: "マイページへ" },
      title: "マイページ" do %>

    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4.5 3.5-7 8-7s8 2.5 8 7"></path>
    </svg>

  <% end %>

  <p class="questions-notice"><%= notice %></p>

  <!-- 学年・クラス・教科 -->
  <div class="classroom-header">
    <div class="classroom-header-item">
      <%= @grade %>年
    </div>

    <div class="classroom-header-item">
      <%= @classroom %>組
    </div>

    <div class="classroom-header-item">
      <%= @subject&.subject_name || "教科未登録" %>
    </div>
  </div>

  <!-- 検索欄 -->
  <div class="questions-search">
    <%= form_with url: classroom_questions_path, method: :get, local: true do %>
      <%= hidden_field_tag :grade, @grade %>
      <%= hidden_field_tag :classroom, @classroom %>
      <%= hidden_field_tag :subject, @subject_number %>

      <%= text_field_tag :q, params[:q],
          placeholder: "質問を検索",
          class: "questions-search-input" %>

      <%= submit_tag "検索", class: "questions-search-button" %>
    <% end %>
  </div>

  <!-- 質問一覧 -->
  <table class="questions-table">
    <thead>
      <tr>
        <th>日付</th>
        <th>内容</th>
        <th>ブクマ</th>
      </tr>
    </thead>

    <tbody>
      <% @questions.each do |question| %>
        <tr>
          <!-- 日付 -->
          <td>
            <%= question.deadline %>
          </td>

          <!-- 質問内容をクリックすると回答一覧画面へ移動 -->
          <td>
            <%= link_to new_answer_path(question_id: question.id),
              class: "question-content-link" do %>
              <%= question.q_content %>
            <% end %>
          </td>

          <!-- ブックマーク -->
          <td class="bookmark-cell">
            <% if logged_in? %>
              <% bookmark = current_user.bookmarks.find_by(
                question_id: question.id
              ) %>

              <% if bookmark %>
                <%= button_to "★",
                    bookmark_path(bookmark),
                    method: :delete,
                    class: "bookmark-button bookmarked",
                    title: "ブックマークを解除" %>
              <% else %>
                <%= button_to "☆",
                    bookmarks_path,
                    method: :post,
                    params: { question_id: question.id },
                    class: "bookmark-button",
                    title: "ブックマークに保存" %>
              <% end %>
            <% else %>
              <%= link_to "☆", login_path,
                  title: "ログインして保存" %>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if @questions.empty? %>
        <tr>
          <td colspan="3" class="empty-message">
            質問はまだありません。
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- ページネーション -->
  <div class="questions-pagination">
    <%= paginate @questions,
        params: {
          grade: @grade,
          classroom: @classroom,
          subject: @subject_number,
          q: params[:q]
        } %>
  </div>

  <!-- 質問一覧に戻る -->
  <div class="classroom-back">
    <%= link_to "質問一覧に戻る", questions_path %>
  </div>

  <!-- 質問追加ボタン -->
  <div class="questions-add">
    <%= link_to "+",
        new_question_path(
          grade: @grade,
          classroom: @classroom,
          subject: @subject_number
        ),
        aria: { label: "質問を追加" } %>
  </div>

</div>
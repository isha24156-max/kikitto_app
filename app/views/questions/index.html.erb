<p style="color: green"><%= notice %></p>

<% content_for :title, "Questions" %>

<h1>質問一覧</h1>

<div id="questions">
  <% @questions.each do |question| %>
    <%= render question %>
    <p>
      <%= link_to "この質問を見る", question %>
    </p>
  <% end %>
</div>

<%= link_to "質問追加", new_question_path %>

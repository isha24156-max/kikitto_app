<% content_for :title, "ホーム" %>

<div class="questions-container home-container">

  <!-- マイページボタン -->
  <%= link_to mypage_index_path,
      class: "mypage-icon-button",
      aria: { label: "マイページへ" },
      title: "マイページ" do %>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
    </svg>
  <% end %>

  <p class="questions-notice"><%= notice %></p>

  <!-- 学年・クラス・教科の選択 -->
  <div class="home-selection-area">

    <h1 class="home-title">クラスを選択してください</h1>

    <div class="questions-header">

      <!-- 学年 -->
      <div class="dropdown">
        <button type="button" class="dropdown-label">
          学年 ▼
        </button>

        <div class="dropdown-menu">
          <% (1..3).each do |n| %>
            <button type="button"
                    data-category="grade"
                    data-value="<%= n %>"
                    data-label="<%= n %>年">
              <%= n %>年
            </button>
          <% end %>
        </div>
      </div>

      <!-- クラス -->
      <div class="dropdown">
        <button type="button" class="dropdown-label">
          クラス ▼
        </button>

        <div class="dropdown-menu">
          <% (1..4).each do |n| %>
            <button type="button"
                    data-category="classroom"
                    data-value="<%= n %>"
                    data-label="<%= n %>組">
              <%= n %>組
            </button>
          <% end %>
        </div>
      </div>

      <!-- 教科 -->
      <div class="dropdown">
        <button type="button" class="dropdown-label">
          教科 ▼
        </button>

        <div class="dropdown-menu">
          <% (1..6).each do |n| %>
            <% subject = Subject.find_by(id: n) %>
            <% subject_name = subject&.subject_name || "教科未登録" %>

            <button type="button"
                    data-category="subject"
                    data-value="<%= n %>"
                    data-label="<%= subject_name %>">
              <%= subject_name %>
            </button>
          <% end %>
        </div>
      </div>

    </div>
  </div>

  <!-- 選択確認画面 -->
  <div id="class-confirm-modal"
       class="class-confirm-modal"
       hidden>

    <div class="class-confirm-box">
      <h2>クラスの確認</h2>

      <p id="class-confirm-message"></p>

      <div class="class-confirm-buttons">
        <button type="button" id="class-cancel">
          キャンセル
        </button>

        <button type="button" id="class-ok">
          OK
        </button>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  const container = document.querySelector(".home-container");

  if (!container || container.dataset.initialized === "true") {
    return;
  }

  container.dataset.initialized = "true";

  let selectedGrade = null;
  let selectedClassroom = null;
  let selectedSubject = null;
  let selectedSubjectName = null;

  const modal = document.getElementById("class-confirm-modal");
  const message = document.getElementById("class-confirm-message");
  const cancelButton = document.getElementById("class-cancel");
  const okButton = document.getElementById("class-ok");

  // 選択肢をクリックしたとき
  container.querySelectorAll(".dropdown-menu button").forEach(function(button) {

    button.addEventListener("click", function() {

      const dropdown = button.closest(".dropdown");
      const label = dropdown.querySelector(".dropdown-label");

      const category = button.dataset.category;
      const value = button.dataset.value;
      const text = button.dataset.label;

      // 選択した内容を表示
      label.textContent = text + " ▼";

      // 選択状態を更新
      dropdown.querySelectorAll(".dropdown-menu button").forEach(function(item) {
        item.classList.remove("selected");
      });

      button.classList.add("selected");

      // 選択内容を保存
      if (category === "grade") {
        selectedGrade = value;
      }

      if (category === "classroom") {
        selectedClassroom = value;
      }

      if (category === "subject") {
        selectedSubject = value;
        selectedSubjectName = text;
      }

      // 3項目すべて選択されたら確認画面を表示
      if (selectedGrade && selectedClassroom && selectedSubject) {

        message.textContent =
          "あなたは" +
          selectedGrade + "年" +
          selectedClassroom + "組の" +
          selectedSubjectName +
          "のクラスに入りますか？";

        modal.hidden = false;
      }

    });

  });

  // キャンセル
  cancelButton.addEventListener("click", function() {
    modal.hidden = true;
  });

  // OK
  okButton.addEventListener("click", function() {

    const params = new URLSearchParams({
      grade: selectedGrade,
      classroom: selectedClassroom,
      subject: selectedSubject
    });

    window.location.href =
      "/questions/classroom?" + params.toString();

  });

})();
</script>
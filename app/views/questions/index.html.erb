
<% content_for :title, "質問一覧" %>

<div class="questions-container">
 

  <p class="questions-notice"><%= notice %></p>

  <div class="questions-header">

    <div class="dropdown">
      <button type="button" class="dropdown-label">学年 ▼</button>
      <div class="dropdown-menu">
        <% (1..3).each do |n| %>
          <button type="button"
                  onclick="selectOption(this, '学年', <%= n %>)">
            <%= n %>
          </button>
        <% end %>
      </div>
    </div>

    <div class="dropdown">
      <button type="button" class="dropdown-label">クラス ▼</button>
      <div class="dropdown-menu">
        <% (1..4).each do |n| %>
          <button type="button"
                  onclick="selectOption(this, 'クラス', <%= n %>)">
            <%= n %>
          </button>
        <% end %>
      </div>
    </div>

    <div class="dropdown">
      <button type="button" class="dropdown-label">教科 ▼</button>
      <div class="dropdown-menu">
        <% (1..6).each do |n| %>
          <button type="button"
                  onclick="selectOption(this, '教科', <%= n %>)">
            <%= n %>
          </button>
        <% end %>
      </div>
    </div>

    
  </div>

  <form class="questions-search" action="<%= questions_path %>" method="get">
    <input
      type="text"
      name="q"
      placeholder="質問を検索"
      value="<%= params[:q] %>"
      aria-label="質問を検索"
    >
    <button type="submit">検索</button>
  </form>

  <table class="questions-table">
    <thead>
      <tr>
        <th>日付</th>
        <th>内容</th>
        <th>回答</th>
        <th>ブクマ</th>
      </tr>
    </thead>

    <tbody>
      <% @questions.each do |question| %>
        <tr>
          <td><%= question.deadline %></td>
          <td>
            <%= question.q_content %>
            <div class="question-link">
              <%= link_to "この質問を見る", new_answer_path %>
            </div>
          </td>
          <td></td>
          <td>
            <span class="bookmark-box">□</span>
          </td>
        </tr>
      <% end %>

      <% if @questions.empty? %>
        <tr>
          <td colspan="4" class="empty-message">
            質問はまだありません。
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="questions-pagination">
    <% total_pages = [(@questions.count / 5.0).ceil, 1].max %>

    <% (1..total_pages).each do |page| %>
      <a href="#"
         class="<%= 'active' if page == 1 %>"
         aria-current="<%= 'page' if page == 1 %>"
         onclick="event.preventDefault();">
        <%= page %>
      </a>
    <% end %>
  </div>

  <div class="questions-add">
    <%= link_to "+", new_question_path, aria: { label: "質問を追加" } %>
  </div>
</div>

<script>
  function selectOption(button, category, number) {
    const dropdown = button.closest(".dropdown");
    const label = dropdown.querySelector(".dropdown-label");

    label.textContent = category + " " + number + " ▼";
    dropdown.querySelectorAll(".dropdown-menu button").forEach((item) => {
      item.classList.remove("selected");
    });
    button.classList.add("selected");
  }
</script>

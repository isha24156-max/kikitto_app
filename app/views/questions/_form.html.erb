
<%= form_with(model: question, local: true) do |form| %>
  <% if question.errors.any? %>
    <div style="color: red">
      <h2>質問を保存できませんでした。</h2>
      <ul>
        <% question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 専用クラスルームに戻るためのパラメータ保持 %>
  <%= hidden_field_tag :grade, params[:grade] || (defined?(grade) ? grade : nil) %>
  <%= hidden_field_tag :classroom, params[:classroom] || (defined?(classroom) ? classroom : nil) %>
  <%= hidden_field_tag :subject, params[:subject] || (defined?(subject) ? subject : nil) %>

  <div>
    <%= form.label :q_content, "質問内容", style: "display: block" %>
    <%= form.text_area :q_content %>
  </div>

  <br>

  <div>
    <%= form.submit "質問を投稿する" %>
  </div>
<% end %>

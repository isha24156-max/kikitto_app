<h1>ログイン</h1>

<%= form_with(url: login_path, scope: :session, local: true) do |f| %>
  <div>
    <%= f.label :mail, "メールアドレス" %>
    <%= f.email_field :mail %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.submit "ログイン" %>
  </div>
<% end %>

<%= link_to "新規登録はこちら", new_user_path %>
